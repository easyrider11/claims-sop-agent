# Pick ONE provider key. The UI can also take a key per conversation (it overrides these).
# Tested path: OpenAI gpt-4.1-mini (about $0.03 for the whole scenario suite).
OPENAI_API_KEY=

# Anthropic (default claude-opus-5-5; written against the current SDK, not run live yet).
# Roughly 10-40x the per-turn cost of gpt-4.1-mini. Set ANTHROPIC_MODEL=claude-sonnet-5-5 for a cheaper run.
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint, e.g. SiliconFlow:
# LLM_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# (generic: OPENAI_API_KEY + OPENAI_BASE_URL + OPENAI_MODEL)

# Hard cap on model spend per server process. Over the cap, model calls stop and the harness
# continues on rules + templates (labelled "degraded" in the UI).
MAX_SPEND_USD=5

# Optional. Put comments on their own line, like these.
# auto | anthropic | openai | siliconflow | none (rules-only, no model)
# LLM_PROVIDER=auto
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_EFFORT=low
# Pin the business date, e.g. to be inside CL-2048's appeal window:
# DEMO_TODAY=2026-02-01
# Timezone the business date is computed in (the container clock is UTC):
# BUSINESS_TZ=America/Los_Angeles
